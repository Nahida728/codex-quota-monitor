{
  "name": "codex-quota-monitor",
  "version": "1.3.41",
  "description": "A bilingual liquid-glass desktop monitor for Codex rate limits and reset credits.",
  "main": "src/main.js",
  "author": "Codex Quota Monitor",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "icons": "node scripts/build-icons.js",
    "prebuild": "npm run icons",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.codex.quota-monitor",
    "productName": "Codex监测台",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/tray-icon-on-dark.png",
        "to": "tray-icon-on-dark.png"
      },
      {
        "from": "assets/tray-icon-on-light.png",
        "to": "tray-icon-on-light.png"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "codex-quota-monitor-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Codex监测台"
    },
    "portable": {
      "artifactName": "codex-quota-monitor-${version}-portable-${arch}.${ext}"
    },
    "buildVersion": "1.3.41.0",
    "beforePack": "./scripts/filter-packaged-docs.cjs",
    "publish": {
      "provider": "github",
      "owner": "Nahida728",
      "repo": "codex-quota-monitor",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "sharp": "0.34.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "koffi": "^3.1.2",
    "semver": "7.7.3"
  },
  "displayVersion": "1.3.41"
}
